module Float {

testcase eq() {
  if (5.0 == 5.0) {
  } else {
    setverdict(fail);
  }

  var float f1 := 5.0;
  var float f2 := 5.0;
  if (f1 == f2) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase eq_contradiction() {
  if (5.0 == 6.0) {
    setverdict(fail);
  }

  var float f1 := 5.0;
  var float f2 := 6.0;
  if (f1 == f2) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase ne() {
  if (5.0 != 6.0) {
  } else {
    setverdict(fail);
  }

  var float f1 := 5.0;
  var float f2 := 6.0;
  if (f1 != f2) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase ne_contradiction() {
  if (5.0 != 5.0) {
    setverdict(fail);
  }

  var float f1 := 5.0;
  var float f2 := 5.0;
  if (f1 != f2) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase add() {
  if ((2.0 + 3.0) != 5.0) {
    setverdict(fail);
  }

  var float f1 := 2.0;
  var float f2 := 3.0;
  if ((f1 + f2) != 5.0) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase sub() {
  if ((10.0 - 3.0) != 7.0) {
    setverdict(fail);
  }

  var float f1 := 10.0;
  var float f2 := 3.0;
  if ((f1 - f2) != 7.0) {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase sub_neg() {
  if ((3.0 - 10.0) != -7.0) {
    setverdict(fail);
  }

  var float f1 := 3.0;
  var float f2 := 10.0;
  if ((f1 - f2) != -7.0) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase mul() {
  if ((4.0 * 5.0) != 20.0) {
    setverdict(fail);
  }

  var float f1 := 4.0;
  var float f2 := 5.0;
  if ((f1 * f2) != 20.0) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase div() {
  if ((20.0 / 5.0) != 4.0) {
    setverdict(fail);
  }

  var float f1 := 20.0;
  var float f2 := 5.0;
  if ((f1 / f2) != 4.0) {
    setverdict(fail);
  }

  setverdict(pass);
}

}
