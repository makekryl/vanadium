module Bitstring {

testcase eq() {
  if ('101001'B == '101001'B) {
  } else {
    setverdict(fail);
  }

  var bitstring bs1 := '101001'B;
  var bitstring bs2 := '101001'B;
  if (bs1 == bs2) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase eq_contradiction() {
  if ('101001'B == '000011'B) {
    setverdict(fail);
  }

  var bitstring bs1 := '101001'B;
  var bitstring bs2 := '000011'B;
  if (bs1 == bs2) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase ne() {
  if ('101001'B != '000011'B) {
    setverdict(fail);
  }

  var bitstring bs1 := '101001'B;
  var bitstring bs2 := '000011'B;
  if (bs1 != bs2) {
  } else {
    setverdict(fail);
  }
  if (bs1 != bs1) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase ne_contradiction() {
  if ('101001'B != '101001'B) {
    setverdict(fail);
  }

  var bitstring bs1 := '101001'B;
  var bitstring bs2 := '101001'B;
  if (bs1 != bs2) {
    setverdict(fail);
  }
  if (bs1 != bs1) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase concat() {
  var bitstring bs := '101001'B;
  bs := bs & '000011'B;
  if (bs != '101001000011'B) {
    setverdict(fail);
  }

  bs := bs & '11'B & bs;
  if (bs != '10100100001111101001000011'B) {
    setverdict(fail);
  }

  setverdict(pass);
}

///

testcase rotl_1() {
  if (('101010'B @> 1) != '101010'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_2() {
  if (('101100'B @> 2) != '110010'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_3() {
  if (('101100'B @> 3) != '101100'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_13() {
  if (('101100'B @> 13) != '011001'B) { setverdict(fail); }
  setverdict(pass);
}
//
//
testcase rotl_neg_1() {
  if (('101100'B @> -1) != '110010'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_2() {
  if (('101100'B @> -2) != '011001'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_3() {
  if (('101100'B @> -3) != '101100'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_13() {
  if (('101100'B @> -13) != '110010'B) { setverdict(fail); }
  setverdict(pass);
}
//
//
testcase rotl_empty() {
  if ((''B @> 42) != ''B) { setverdict(fail); }
  setverdict(pass);
}

///

testcase rotr_1() {
  if (('101100'B <@ 1) != '110010'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_2() {
  if (('101100'B <@ 2) != '011001'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_3() {
  if (('101100'B <@ 3) != '101100'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_13() {
  if (('101100'B <@ 13) != '110010'B) { setverdict(fail); }
  setverdict(pass);
}
//
//
testcase rotr_neg_1() {
  if (('101100'B <@ -1) != '011001'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_neg_2() {
  if (('101100'B <@ -2) != '110010'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_neg_3() {
  if (('101100'B <@ -3) != '101100'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_neg_13() {
  if (('101100'B <@ -13) != '011001'B) { setverdict(fail); }
  setverdict(pass);
}
//
//
testcase rotr_empty() {
  if ((''B <@ 42) != ''B) { setverdict(fail); }
  setverdict(pass);
}

///

testcase concat_large() {
  var bitstring bs := ''B;
  bs := bs & '11'B;
  bs := bs & '00'B;
  bs := bs & '01'B;
  bs := bs & '10'B;
  bs := bs & '00'B;
  bs := bs & '00'B;
  bs := bs & '01'B;
  bs := bs & '10'B;
  bs := bs & '10'B;
  bs := bs & '00'B;
  bs := bs & '10'B;
  bs := bs & '11'B;
  bs := bs & '11'B;
  bs := bs & '00'B;
  bs := bs & '01'B;
  bs := bs & '11'B;
  bs := bs & '11'B;
  bs := bs & '00'B;
  bs := bs & '01'B;

  if (bs != '11000110000001101000101111000111110001'B) {
    setverdict(fail);
  }

  setverdict(pass);
}

}
