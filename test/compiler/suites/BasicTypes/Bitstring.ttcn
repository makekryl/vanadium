///

testcase concat_large() {
  var bitstring bs := ''B;
  bs := bs & '11'B;
  bs := bs & '00'B;
  bs := bs & '01'B;
  bs := bs & '10'B;
  bs := bs & '00'B;
  bs := bs & '00'B;
  bs := bs & '01'B;
  bs := bs & '10'B;
  bs := bs & '10'B;
  bs := bs & '00'B;
  bs := bs & '10'B;
  bs := bs & '11'B;
  bs := bs & '11'B;
  bs := bs & '00'B;
  bs := bs & '01'B;
  bs := bs & '11'B;
  bs := bs & '11'B;
  bs := bs & '00'B;
  bs := bs & '01'B;

  if (bs != '11000110000001101000101111000111110001'B) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase concat_large_uneven() {
  var bitstring bs := ''B;
  bs := bs & '1'B;
  bs := bs & '0'B;
  bs := bs & '0'B;
  bs := bs & '1'B;
  bs := bs & '0'B;
  bs := bs & '0'B;
  bs := bs & '0'B;
  bs := bs & '1'B;
  bs := bs & '1'B;
  bs := bs & '0'B;
  bs := bs & '1'B;
  bs := bs & '1'B;
  bs := bs & '1'B;
  bs := bs & '0'B;
  bs := bs & '0'B;
  bs := bs & '1'B;
  bs := bs & '1'B;
  bs := bs & '0'B;
  bs := bs & '0'B;

  if (bs != '1001000110111001100'B) {
    setverdict(fail);
  }

  setverdict(pass);
}

}
