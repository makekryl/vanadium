testcase concat_uneven() {
  var bitstring bs := '1010011'B;
  bs := bs & '0000111'B;
  if (bs != '10100110000111'B) {
    setverdict(fail);
  }

  bs := bs & '1'B & bs;
  if (bs != '10100110000111110100110000111'B) {
    setverdict(fail);
  }

  setverdict(pass);
}

