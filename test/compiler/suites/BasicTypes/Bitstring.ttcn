testcase ne_uneven() {
  if ('1010011'B != '0000111'B) {
  } else {
    setverdict(fail);
  }

  var bitstring bs1 := '1010011'B;
  var bitstring bs2 := '0000111'B;
  if (bs1 != bs2) {
  } else {
    setverdict(fail);
  }
  if (bs2 != bs1) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase ne_contradiction_uneven() {
  if ('1010011'B != '1010011'B) {
    setverdict(fail);
  }

  var bitstring bs1 := '1010011'B;
  var bitstring bs2 := '1010011'B;
  if (bs1 != bs2) {
    setverdict(fail);
  }
  if (bs1 != bs1) {
    setverdict(fail);
  }

  setverdict(pass);
