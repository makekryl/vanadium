module Hexstring {

testcase eq() {
  if ('44B0BA'H == '44B0BA'H) {
  } else {
    setverdict(fail);
  }

  var hexstring hs1 := '44B0BA'H;
  var hexstring hs2 := '44B0BA'H;
  if (hs1 == hs2) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase eq_contradiction() {
  if ('44B0BA'H == '00B0BA'H) {
    setverdict(fail);
  }

  var hexstring hs1 := '44B0BA'H;
  var hexstring hs2 := '00B0BA'H;
  if (hs1 == hs2) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase ne() {
  if ('44B0BA'H != '00B0BA'H) {
  } else {
    setverdict(fail);
  }

  var hexstring hs1 := '44B0BA'H;
  var hexstring hs2 := '00B0BA'H;
  if (hs1 != hs2) {
  } else {
    setverdict(fail);
  }
  if (hs1 != hs1) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase ne_contradiction() {
  if ('44B0BA'H != '44B0BA'H) {
    setverdict(fail);
  }

  var hexstring hs1 := '44B0BA'H;
  var hexstring hs2 := '44B0BA'H;
  if (hs1 != hs2) {
    setverdict(fail);
  }
  if (hs1 != hs1) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase concat() {
  var hexstring hs := '44B0BA'H;
  hs := hs & '00B0BA'H;
  if (hs != '44B0BA00B0BA'H) {
    setverdict(fail);
  }

  hs := hs & '55'H & hs;
  if (hs != '44B0BA00B0BA5544B0BA00B0BA'H) {
    setverdict(fail);
  }

  setverdict(pass);
}

///

testcase rotl_1() {
  if (('ABCDEF'H @> 1) != 'EFABCD'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_2() {
  if (('ABCDEF'H @> 2) != 'CDEFAB'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_3() {
  if (('ABCDEF'H @> 3) != 'ABCDEF'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_13() {
  if (('ABCDEF'H @> 13) != 'EFABCD'H) { setverdict(fail); }
  setverdict(pass);
}
//
testcase rotl_neg_1() {
  if (('ABCDEF'H @> -1) != 'CDEFAB'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_2() {
  if (('ABCDEF'H @> -2) != 'EFABCD'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_3() {
  if (('ABCDEF'H @> -3) != 'ABCDEF'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_13() {
  if (('ABCDEF'H @> -13) != 'CDEFAB'H) { setverdict(fail); }
  setverdict(pass);
}
//
testcase rotl_empty() {
  if ((''H @> 42) != ''H) { setverdict(fail); }
  setverdict(pass);
}

///

testcase rotr_1() {
  if (('ABCDEF'H <@ 1) != 'CDEFAB'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_2() {
  if (('ABCDEF'H <@ 2) != 'EFABCD'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_3() {
  if (('ABCDEF'H <@ 3) != 'ABCDEF'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_13() {
  if (('ABCDEF'H <@ 13) != 'CDEFAB'H) { setverdict(fail); }
  setverdict(pass);
}
//
testcase rotr_neg_1() {
  if (('ABCDEF'H <@ -1) != 'EFABCD'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_neg_2() {
  if (('ABCDEF'H <@ -2) != 'CDEFAB'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_neg_3() {
  if (('ABCDEF'H <@ -3) != 'ABCDEF'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_neg_13() {
  if (('ABCDEF'H <@ -13) != 'EFABCD'H) { setverdict(fail); }
  setverdict(pass);
}
//
testcase rotr_empty() {
  if ((''H <@ 42) != ''H) { setverdict(fail); }
  setverdict(pass);
}

///

testcase concat_large() {
  var hexstring hs := ''H;
  hs := hs & '55'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & '12'H;
  hs := hs & '34'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & '12'H;
  hs := hs & '34'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & '55'H;

  if (hs != '55ABAB1234ABABABABABABABABABABABAB1234ABAB55'H) {
    setverdict(fail);
  }

  setverdict(pass);
}

}
