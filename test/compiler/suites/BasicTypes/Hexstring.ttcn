///

testcase concat_large() {
  var hexstring hs := ''H;
  hs := hs & '55'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & '12'H;
  hs := hs & '34'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & '12'H;
  hs := hs & '34'H;
  hs := hs & 'AB'H;
  hs := hs & 'AB'H;
  hs := hs & '55'H;

  if (hs != '55ABAB1234ABABABABABABABABABABABAB1234ABAB55'H) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase concat_large_uneven() {
  var hexstring hs := ''H;
  hs := hs & '5'H;
  hs := hs & 'A'H;
  hs := hs & 'A'H;
  hs := hs & '1'H;
  hs := hs & '3'H;
  hs := hs & 'A'H;
  hs := hs & 'A'H;
  hs := hs & 'A'H;
  hs := hs & 'A'H;
  hs := hs & 'A'H;
  hs := hs & 'A'H;
  hs := hs & 'A'H;
  hs := hs & 'A'H;
  hs := hs & 'A'H;
  hs := hs & 'A'H;
  hs := hs & 'A'H;
  hs := hs & 'A'H;
  hs := hs & '1'H;
  hs := hs & '3'H;
  hs := hs & 'A'H;
  hs := hs & 'A'H;
  hs := hs & '5'H;

  if (hs != '5AA13AAAAAAAAAAAA13AA5'H) {
    setverdict(fail);
  }

  setverdict(pass);
}

}
