  }

  setverdict(pass);
}

testcase ne_uneven() {
  if ('44B0BAB'H != '00B0BAB'H) {
  } else {
    setverdict(fail);
  }

  var hexstring hs1 := '44B0BAB'H;
  var hexstring hs2 := '00B0BAB'H;
  if (hs1 != hs2) {
  } else {
    setverdict(fail);
  }
  if (hs2 != hs1) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase ne_contradiction_uneven() {
  if ('44B0BAB'H != '44B0BAB'H) {
    setverdict(fail);
  }

  var hexstring hs1 := '44B0BAB'H;
  var hexstring hs2 := '44B0BAB'H;
  if (hs1 != hs2) {
    setverdict(fail);
  }
  if (hs1 != hs1) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase concat_uneven() {
  var hexstring hs := '44B0BAB'H;
  hs := hs & '00B0BAB'H;
  if (hs != '44B0BAB00B0BAB'H) {
    setverdict(fail);
  }

  hs := hs & '5'H & hs;
  if (hs != '44B0BAB00B0BAB544B0BAB00B0BAB'H) {
    setverdict(fail);
  }

  setverdict(pass);
}

