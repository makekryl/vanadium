module Hexstring {

testcase eq() {
  if ('44B0BA'H == '44B0BA'H) {
  } else {
    setverdict(fail);
  }

  var hexstring hs1 := '44B0BA'H;
  var hexstring hs2 := '44B0BA'H;
  if (hs1 == hs2) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase eq_contradiction() {
  if ('44B0BA'H == '00B0BA'H) {
    setverdict(fail);
  }

  var hexstring hs1 := '44B0BA'H;
  var hexstring hs2 := '00B0BA'H;
  if (hs1 == hs2) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase ne() {
  if ('44B0BA'H != '00B0BA'H) {
  } else {
    setverdict(fail);
  }

  var hexstring hs1 := '44B0BA'H;
  var hexstring hs2 := '00B0BA'H;
  if (hs1 != hs2) {
  } else {
    setverdict(fail);
  }
  if (hs2 != hs1) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase ne_contradiction() {
  if ('44B0BA'H != '44B0BA'H) {
    setverdict(fail);
  }

  var hexstring hs1 := '44B0BA'H;
  var hexstring hs2 := '44B0BA'H;
  if (hs1 != hs2) {
    setverdict(fail);
  }
  if (hs1 != hs1) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase concat() {
  var hexstring hs := '44B0BA'H;
  hs := hs & '00B0BA'H;
  if (hs != '44B0BA00B0BA'H) {
    setverdict(fail);
  }

  hs := hs & '55'H & hs;
  if (hs != '44B0BA00B0BA5544B0BA00B0BA'H) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase eq_uneven() {
  if ('44B0BAB'H == '44B0BAB'H) {
  } else {
    setverdict(fail);
  }

  var hexstring hs1 := '44B0BAB'H;
  var hexstring hs2 := '44B0BAB'H;
  if (hs1 == hs2) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase eq_contradiction_uneven() {
  if ('44B0BAB'H == '00B0BAB'H) {
    setverdict(fail);
  }

  var hexstring hs1 := '44B0BAB'H;
  var hexstring hs2 := '00B0BAB'H;
  if (hs1 == hs2) {
