module Integer {

// TODO: register function like expect(boolean, msg) for compiler e2e

testcase eq() {
  if (5 == 5) {
  } else {
    setverdict(fail);
  }

  var integer i1 := 5;
  var integer i2 := 5;
  if (i1 == i2) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase eq_contradiction() {
  if (5 == 6) {
    setverdict(fail);
  }

  var integer i1 := 5;
  var integer i2 := 6;
  if (i1 == i2) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase ne() {
  if (5 != 6) {
  } else {
    setverdict(fail);
  }

  var integer i1 := 5;
  var integer i2 := 6;
  if (i1 != i2) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase ne_contradiction() {
  if (5 != 5) {
    setverdict(fail);
  }

  var integer i1 := 5;
  var integer i2 := 5;
  if (i1 != i2) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase add() {
  if ((2 + 3) != 5) {
    setverdict(fail);
  }

  var integer i1 := 2;
  var integer i2 := 3;
  if ((i1 + i2) != 5) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase sub() {
  if ((10 - 3) != 7) {
    setverdict(fail);
  }

  var integer i1 := 10;
  var integer i2 := 3;
  if ((i1 - i2) != 7) {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase sub_neg() {
  if ((3 - 10) != -7) {
    setverdict(fail);
  }

  var integer i1 := 3;
  var integer i2 := 10;
  if ((i1 - i2) != -7) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase mul() {
  if ((4 * 5) != 20) {
    setverdict(fail);
  }

  var integer i1 := 4;
  var integer i2 := 5;
  if ((i1 * i2) != 20) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase div() {
  if ((20 / 5) != 4) {
    setverdict(fail);
  }

  var integer i1 := 20;
  var integer i2 := 5;
  if ((i1 / i2) != 4) {
    setverdict(fail);
  }

  setverdict(pass);
}

}
