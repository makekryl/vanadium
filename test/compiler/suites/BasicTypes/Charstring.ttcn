module Charstring {

testcase eq() {
  if ("Hello" == "Hello") {
  } else {
    setverdict(fail);
  }

  var charstring cs1 := "Hello";
  var charstring cs2 := "Hello";
  if (cs1 == cs2) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase eq_contradiction() {
  if ("Hello" == "Hallo") {
    setverdict(fail);
  }

  var charstring cs1 := "Hello";
  var charstring cs2 := "Hallo";
  if (cs1 == cs2) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase ne() {
  if ("Hello" != "Hallo") {
  } else {
    setverdict(fail);
  }

  var charstring cs1 := "Hello";
  var charstring cs2 := "Hallo";
  if (cs1 != cs2) {
  } else {
    setverdict(fail);
  }
  if (cs2 != cs1) {
  } else {
    setverdict(fail);
  }

  setverdict(pass);
}
testcase ne_contradiction() {
  if ("Hello" != "Hello") {
    setverdict(fail);
  }

  var charstring cs1 := "Hello";
  var charstring cs2 := "Hello";
  if (cs1 != cs2) {
    setverdict(fail);
  }
  if (cs1 != cs1) {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase concat() {
  var charstring cs := "Hello";
  cs := cs & " World";
  if (cs != "Hello World") {
    setverdict(fail);
  }

  cs := cs & " " & cs;
  if (cs != "Hello World Hello World") {
    setverdict(fail);
  }

  setverdict(pass);
}

testcase concat_large() {
  var charstring cs := "";
  cs := cs & "_";
  cs := cs & "AB";
  cs := cs & "AB";
  cs := cs & "12";
  cs := cs & "34";
  cs := cs & "AB";
  cs := cs & "AB";
  cs := cs & "AB";
  cs := cs & "AB";
  cs := cs & "AB";
  cs := cs & "AB";
  cs := cs & "AB";
  cs := cs & "AB";
  cs := cs & "AB";
  cs := cs & "AB";
  cs := cs & "AB";
  cs := cs & "AB";
  cs := cs & "12";
  cs := cs & "34";
  cs := cs & "AB";
  cs := cs & "AB";
  cs := cs & "_";

  if (cs != "_ABAB1234ABABABABABABABABABABABAB1234ABAB_") {
    setverdict(fail);
  }

  setverdict(pass);
}

}
