module HexstringRotate {

testcase rotl_empty() {
  if ((''H <@ 42) != ''H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_empty() {
  if ((''H @> 42) != ''H) { setverdict(fail); }
  setverdict(pass);
}

//

testcase rotl_0() {
  if (('ABC123456DEF'H <@ 0) != 'ABC123456DEF'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_1() {
  if (('ABC123456DEF'H <@ 1) != 'BC123456DEFA'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_2() {
  if (('ABC123456DEF'H <@ 2) != 'C123456DEFAB'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_3() {
  if (('ABC123456DEF'H <@ 3) != '123456DEFABC'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_4() {
  if (('ABC123456DEF'H <@ 4) != '23456DEFABC1'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_5() {
  if (('ABC123456DEF'H <@ 5) != '3456DEFABC12'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_7() {
  if (('ABC123456DEF'H <@ 7) != '56DEFABC1234'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_13() {
  if (('ABC123456DEF'H <@ 13) != 'BC123456DEFA'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_17() {
  if (('ABC123456DEF'H <@ 17) != '3456DEFABC12'H) { setverdict(fail); }
  setverdict(pass);
}
//
testcase rotl_neg_0() {
  if (('ABC123456DEF'H <@ 0) != 'ABC123456DEF'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_1() {
  if (('ABC123456DEF'H <@ -1) != 'FABC123456DE'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_2() {
  if (('ABC123456DEF'H <@ -2) != 'EFABC123456D'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_3() {
  if (('ABC123456DEF'H <@ -3) != 'DEFABC123456'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_4() {
  if (('ABC123456DEF'H <@ -4) != '6DEFABC12345'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_5() {
  if (('ABC123456DEF'H <@ -5) != '56DEFABC1234'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_7() {
  if (('ABC123456DEF'H <@ -7) != '3456DEFABC12'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_13() {
  if (('ABC123456DEF'H <@ -13) != 'FABC123456DE'H) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_17() {
  if (('ABC123456DEF'H <@ -17) != '56DEFABC1234'H) { setverdict(fail); }
  setverdict(pass);
}

