  setverdict(pass);
}
testcase rotl_neg_13() {
  if (('01010100101110'B <@ -13) != '10101001011100'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_17() {
  if (('01010100101110'B <@ -17) != '11001010100101'B) { setverdict(fail); }
  setverdict(pass);
}

