module BitstringRotate {

testcase rotl_empty() {
  if ((''B <@ 42) != ''B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_empty() {
  if ((''B @> 42) != ''B) { setverdict(fail); }
  setverdict(pass);
}

//

testcase rotl_0() {
  if (('01010100101110'B <@ 0) != '01010100101110'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_1() {
  if (('01010100101110'B <@ 1) != '10101001011100'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_2() {
  if (('01010100101110'B <@ 2) != '01010010111001'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_3() {
  if (('01010100101110'B <@ 3) != '10100101110010'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_4() {
  if (('01010100101110'B <@ 4) != '01001011100101'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_5() {
  if (('01010100101110'B <@ 5) != '10010111001010'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_7() {
  if (('01010100101110'B <@ 7) != '01011100101010'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_13() {
  if (('01010100101110'B <@ 13) != '00101010010111'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_17() {
  if (('01010100101110'B <@ 17) != '10100101110010'B) { setverdict(fail); }
  setverdict(pass);
}
//
testcase rotl_neg_0() {
  if (('01010100101110'B <@ 0) != '01010100101110'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_1() {
  if (('01010100101110'B <@ -1) != '00101010010111'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_2() {
  if (('01010100101110'B <@ -2) != '10010101001011'B) { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_neg_3() {
