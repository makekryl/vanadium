module CharstringOperations {

testcase rotl_empty() {
  if (("" <@ 42) != "") { setverdict(fail); }
  setverdict(pass);
}
testcase rotr_empty() {
  if (("" @> 42) != "") { setverdict(fail); }
  setverdict(pass);
}

//

testcase rotl_0() {
  if (("charstrtext" <@ 0) != "charstrtext") { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_1() {
  if (("charstrtext" <@ 1) != "harstrtextc") { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_2() {
  if (("charstrtext" <@ 2) != "arstrtextch") { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_3() {
