  setverdict(pass);
}
testcase rotl_4() {
  if (("charstrtext" <@ 4) != "strtextchar") { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_5() {
  if (("charstrtext" <@ 5) != "trtextchars") { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_7() {
  if (("charstrtext" <@ 7) != "textcharstr") { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_13() {
  if (("charstrtext" <@ 13) != "arstrtextch") { setverdict(fail); }
  setverdict(pass);
}
testcase rotl_17() {
  if (("charstrtext" <@ 17) != "rtextcharst") { setverdict(fail); }
  setverdict(pass);
}
