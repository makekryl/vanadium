module IntegerMatching {

testcase SpecificValue() {
  var          integer v1 := 1, v2 := 2;
  var template integer t1 := 1, t2 := 2;

  if (not match(v1, t1)) { setverdict(fail); }
  if (    match(v1, t2)) { setverdict(fail); }
  if (    match(v2, t1)) { setverdict(fail); }

  setverdict(pass);
}

testcase ValueList() {
  var integer v1 := 1, v2 := 2, v3 := 3;
  var template integer t1 := (1), t12 := (1, 2), t123 := (1, 2, 3);

  if (not match(v1, t1))   { setverdict(fail); }
  if (not match(v1, t12))  { setverdict(fail); }
  if (not match(v1, t123)) { setverdict(fail); }
  //
  if (    match(v2, t1))   { setverdict(fail); }
  if (not match(v2, t12))  { setverdict(fail); }
  if (not match(v2, t123)) { setverdict(fail); }
  //
  if (    match(v3, t1))   { setverdict(fail); }
  if (    match(v3, t12))  { setverdict(fail); }
  if (not match(v3, t123)) { setverdict(fail); }

  setverdict(pass);
}

testcase ValueRange() {
  var integer v42 := 42, v100 := 100, v500 := 500;

  var template integer t45_200 := (45..200);
  if (    match(v42, t45_200))  { setverdict(fail); }
  if (not match(v100, t45_200)) { setverdict(fail); }
  if (    match(v500, t45_200)) { setverdict(fail); }

  setverdict(pass);
}

}
