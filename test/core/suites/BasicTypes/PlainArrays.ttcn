function f() {
  var Struct arr[2] := {
    {1},
    {2},
    {"3"}  // EXPECT_ERROR
  };
  var Struct el := arr[0];

  var integer mapping[16] := {
    [1] := 1,
    [2] := 1,
    [3] := 1,
    [4] := 1,
