module OptionalMembers {

type record InnerStruct {
  integer i
}

type record Struct {
  integer x optional,
  integer y,
  InnerStruct optionalInner optional
}

function f_val() {
  var Struct s;

  s.x := omit;
  s.x := *;  // EXPECT_ERROR
  s.x := ?;  // EXPECT_ERROR

  s.y := omit;  // EXPECT_ERROR
  s.y := *;     // EXPECT_ERROR
  s.y := ?;     // EXPECT_ERROR

  s.optionalInner.i := omit;  // EXPECT_ERROR
}

function f_template() {
  var template Struct s;

  s.x := omit;
  s.x := *;
  s.x := ?;

  s.y := omit;
  s.y := *;
  s.y := ?;

  s.optionalInner.i := omit;
}

}
