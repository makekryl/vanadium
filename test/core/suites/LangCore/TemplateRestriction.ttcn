module TemplateRestriction {

function correct() {
  var template integer x;

  x := 1;

  x := omit;
  x := *;
  x := ?;
}

function invalid() {
  var integer x;

  x := omit;  // EXPECT_ERROR
  x := *;  // EXPECT_ERROR
  x := ?;  // EXPECT_ERROR
}

template integer t_int1 := 1;
template integer t_int2 := omit;

}
