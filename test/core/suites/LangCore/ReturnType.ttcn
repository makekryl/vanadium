module ReturnType {

function missingReturnDecl() {
  return 1;  // EXPECT_ERROR
}

function typeMismatch() return integer {
  return 1.0;  // EXPECT_ERROR
}

function templateRestrictionMismatch() return integer {
  var template integer i;
  return i;  // EXPECT_ERROR
}

function ifStmt_noAlternate() return integer {
  var integer i, j;
  if (i == 1) {
    return i;
  }
  return j;
}

function ifStmt_alternate() return integer {
  var integer i, j;
  if (i == 1) {
    return i;
  } else {
    return j;
  }
}

function selectStmt() return integer {
  var integer i, j;
  select (i) {
    case (1) { }
    case (2) { }
  }
  return j;
}

function selectStmt_defaultClause() return integer {
  var integer i, j;
  select (i) {
    case (1) { return i; }
    case else { return j; }
  }
}

function missingReturnStatement() return integer {  // EXPECT_ERROR

}

function missingReturnStatementInABranch_1() return integer {  // EXPECT_ERROR
  var boolean condition;
  if (condition) {
    return 1;
  }
}
function missingReturnStatementInABranch_2() return integer {  // EXPECT_ERROR
  var boolean condition;
  if (condition) {
    return 1;
  } else {

  }
}
function missingReturnStatementInABranch_3() return integer {  // EXPECT_ERROR
  var boolean condition, condition2, condition3;
  if (condition) {
    return 1;
  } else {
    if (condition2) {
      if (condition3) {
        return 3
      }
      return 2
    }
  }
}
function missingReturnStatement_selectStmt() return integer {  // EXPECT_ERROR
  var integer i, j;
  select (i) {
    case (1) { return j; }
    case (2) { return j; }
  }
}

external function externalFunc() return integer;
external function externalFuncThatReturns() return integer;

}
