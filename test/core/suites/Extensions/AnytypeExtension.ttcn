module AnytypeExtension {

type record RecA { integer a }
type record RecB { integer b }
type record RecC { integer c }

function f() {
  var anytype ant;
  var integer x := ant.RecA.a
                 + ant.RecB.b
                 + ant.RecC.c
                 + ant.RecA    // EXPECT_ERROR
                           .c  // EXPECT_ERROR
                 + ant.RecR    // EXPECT_ERROR
                           .r  // EXPECT_ERROR
                 ;
}

} with {
  extension "anytype
    RecA,
    RecB,
    RecC
" }
